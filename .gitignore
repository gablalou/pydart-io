# Rust build artifacts
/target/
crates/*/target/

# maturin develop (editable install) drops the compiled extension module directly into the
# python-source tree — this is a build artifact, not source.
python/pydart/*.so
python/pydart/*.pyd
python/pydart/*.dylib

# Python virtual environment (uv-managed)
.venv/

# Python bytecode/caches
__pycache__/
*.py[cod]
.pytest_cache/
.hypothesis/

# Python packaging artifacts
*.egg-info/
dist/
build/
wheelhouse/

# Editors/OS
.DS_Store
